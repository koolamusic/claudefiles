{
  "$schema": "https://www.schemastore.org/claude-code-keybindings.json",
  "$docs": "https://code.claude.com/docs/en/keybindings",
  "bindings": [
    {
      "context": "Scroll",
      "bindings": {
        "up": null,
        "down": null,
        "alt+j": "scroll:lineDown",
        "alt+k": "scroll:lineUp",
        "alt+shift+j": "scroll:pageDown",
        "alt+shift+k": "scroll:pageUp"
      }
    },
    {
      "context": "Transcript",
      "bindings": {
        "up": null,
        "down": null
      }
    }
  ]
}
